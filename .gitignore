__pycache__/
*.py[cod]
.venv/
.pytest_cache/
dist/
build/
*.egg-info/

# What a run produces. Keeping these out stops a run from committing its own
# output back into the repository.
out/
*.jsonl
*.geojson

# The viewer's sample is shipped with the code rather than produced by a run,
# so it is tracked despite the rules above.
!web/public/sample/**
!lenses/**/*.json

# Screenshots and scratch work. Not published.
tmp/

# Where the README has you clone the programs this drives. Kept inside the
# checkout so nothing is written outside it, and ignored so it stays out of
# `git status`. `rm -rf .tools` undoes it.
/.tools/

# One machine's declaration, copied from speechmap.example.yaml. Yours will
# name different endpoints, so it is not shared.
/speechmap.yaml
