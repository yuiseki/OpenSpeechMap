# MapLibre style. The default is MapLibre's demo style, which needs no signup
# and is fine for looking at your own output. Point it at your own tiles for
# anything you intend to publish.
VITE_MAP_STYLE=https://demotiles.maplibre.org/style.json

# Where the viewer fetches its two inputs from, relative to the page.
VITE_SERIES_URL=./sample/series.json
VITE_PLACES_URL=./sample/places.geojson
